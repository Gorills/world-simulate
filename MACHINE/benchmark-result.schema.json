{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythic-world.local/schemas/benchmark-result.schema.json",
  "title": "BenchmarkResult",
  "type": "object",
  "required": [
    "id",
    "workload_id",
    "workload_version",
    "subject_id",
    "subject_version",
    "version_bundle",
    "execution_mode",
    "environment",
    "seed_ids",
    "workload_parameters",
    "duration",
    "instrumentation_overhead",
    "repetitions",
    "metrics",
    "budget_status_before",
    "budget_status_after",
    "interpretation",
    "timestamp"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 4},
    "workload_id": {"type": "string", "pattern": "^RW-[A-Z]_[A-Z0-9_]+$"},
    "workload_version": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 2},
    "subject_version": {"type": "string", "minLength": 1},
    "execution_mode": {"enum": ["headless", "client", "debug", "release"]},
    "environment": {
      "type": "object",
      "required": ["hardware_class", "os", "runtime"],
      "properties": {
        "hardware_class": {"type": "string", "minLength": 4},
        "os": {"type": "string", "minLength": 3},
        "runtime": {"type": "string", "minLength": 3}
      },
      "additionalProperties": true
    },
    "seed_ids": {"type": "array", "minItems": 1, "items": {}},
    "workload_parameters": {"type": "object", "minProperties": 1},
    "duration": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "iterations": {"type": "integer", "minimum": 1},
        "world_time_span": {"type": "string", "minLength": 2},
        "wall_time_target": {"type": "string", "minLength": 2}
      },
      "additionalProperties": false
    },
    "instrumentation_overhead": {"type": "string", "minLength": 4},
    "repetitions": {"type": "integer", "minimum": 1},
    "metrics": {"type": "object", "minProperties": 1},
    "baseline_result_id": {"type": ["string", "null"]},
    "regression_deltas": {"type": "object"},
    "budget_status_before": {"enum": ["MEASURED", "UNMEASURED_BLOCKER", "DEFERRED_MEASUREMENT", "NOT_APPLICABLE"]},
    "budget_status_after": {"enum": ["MEASURED", "UNMEASURED_BLOCKER", "DEFERRED_MEASUREMENT", "NOT_APPLICABLE"]},
    "interpretation": {"type": "string", "minLength": 12},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 4}},
    "timestamp": {"type": "string", "format": "date-time"},
    "target_hardware_class": {"type": "string", "minLength": 4},
    "safety_margin_rationale": {"type": "string", "minLength": 8},
    "regression_threshold": {"type": "string", "minLength": 4},
    "version_bundle": {"type": "object"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"budget_status_after": {"const": "MEASURED"}}, "required": ["budget_status_after"]},
      "then": {
        "required": ["target_hardware_class", "safety_margin_rationale", "regression_threshold"],
        "properties": {"repetitions": {"minimum": 2}}
      }
    }
  ]
}
